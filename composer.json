{
    "name": "developer-entity/entityindex-yii2",
    "description": "EntityIndex: searchable index of new US business filings (Yii2 basic, MySQL, Bootstrap, AdminLTE portal)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.54",
        "yiisoft/yii2-symfonymailer": "~2.0.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0"
    },
    "replace": {
        "bower-asset/jquery": "*",
        "bower-asset/inputmask": "*",
        "bower-asset/punycode": "*",
        "bower-asset/yii2-pjax": "*"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "test": "php tests/run.php"
    },
    "extra": {
        "yii\\composer\\Installer::postInstall": {
            "setPermission": [
                {
                    "runtime": "0775",
                    "web/assets": "0775",
                    "yii": "0755"
                }
            ]
        }
    }
}
