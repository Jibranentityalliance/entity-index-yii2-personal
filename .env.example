# Copy to .env and edit. Never commit .env.
YII_ENV=dev
YII_DEBUG=true

# MySQL 8 (or MariaDB 10.6+)
DB_DSN="mysql:host=127.0.0.1;dbname=entityindex"
DB_USER=entityindex
DB_PASS=change-me

# Random 32+ char string (cookie signing)
COOKIE_VALIDATION_KEY=change-me-to-a-long-random-string

# Canonical site URL, used in sitemaps, canonical links and JSON-LD
SITE_URL=https://entityindex.com

# live | coming_soon (coming_soon shows only the waitlist page)
SITE_MODE=live

# true (default): every response says noindex,nofollow. Set false at launch to allow search engines.
SITE_NOINDEX=true

# Where "contact" mail goes / sender (optional)
ADMIN_EMAIL=admin@entityindex.com
