# Copy to .env and edit. Never commit .env.
# On a server make it readable by the web user: chown deploy:www-data .env && chmod 640 .env
# Quote values that contain spaces, # or $:  DB_PASS="p#ss word"
# Required: DB_DSN, DB_USER, COOKIE_VALIDATION_KEY, SITE_URL. Check with: php yii env/check
YII_ENV=dev
YII_DEBUG=true

# MySQL 8 (or MariaDB 10.6+)
DB_DSN="mysql:host=127.0.0.1;dbname=entityindex"
DB_USER=entityindex
DB_PASS=change-me

# Random 32+ char string (cookie signing)
COOKIE_VALIDATION_KEY=change-me-to-a-long-random-string

# Canonical site URL, used in sitemaps, canonical links and JSON-LD
SITE_URL=https://entityindex.com

# live | coming_soon (coming_soon shows only the waitlist page)
SITE_MODE=live

# true (default): every response says noindex,nofollow. Set false at launch to allow search engines.
SITE_NOINDEX=true

# Where "contact" mail goes / sender (optional)
ADMIN_EMAIL=admin@entityindex.com

# Replicated portal data on this same MariaDB server (home-page numbers: php yii stats/refresh). Defaults shown.
# MIRROR_DB=ein_skip_tracing
# MIRROR_TZ=America/New_York

# EIN skip-tracing database (optional; only `php yii ein-sync/companies` uses it). Use a read-only DB user.
# DB_DSN_EIN_SKIP_TRACING="mysql:host=db.example.com;dbname=ein_skip_tracing"
# DB_USER_EIN_SKIP_TRACING=entityindex
# DB_PASS_EIN_SKIP_TRACING=change-me
